DB_PASS=TotvsPassword@123

# --- POSTGRES ENGINE CONFIGURATION (ROOT SUPERUSER) ---------------------------
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=root_postgres_secure_password

# --- SQL SERVER ENGINE CONFIGURATION (SA SUPERUSER) ---------------------------
MSSQL_SA_PASSWORD=YourStrong@Password2026

# --- ACTIVE INFRASTRUCTURE PER PROFILE ---------------------------------------
# Opção Postgres: DB_TYPE=POSTGRES   | DB_SERVER=protheus_postgres  | DB_PORT=5432
# Opção MSSQL:    DB_TYPE=MSSQL      | DB_SERVER=protheus_sqlserver | DB_PORT=1433
DB_TYPE=MSSQL
DB_SERVER=protheus_sqlserver
DB_PORT=1433