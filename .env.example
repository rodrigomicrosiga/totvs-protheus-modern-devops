# --- LICENSE CONFIGURATION ---------------------------------------------------
LICENSE_SERVER_HOST=protheus_license
LICENSE_SERVER_PORT=5555

# --- ENVIRONMENT CONFIGURATION -----------------------------------------------
ENV_NAME=protheus_prod   # <-- NOVA VARIÁVEL: Nome do ambiente/seção no Protheus

# --- TARGET DATABASE CONFIGURATION (PROTHEUS CREDENTIALS) ---------------------
DB_NAME=protheus_prod
