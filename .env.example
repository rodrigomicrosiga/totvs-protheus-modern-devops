# Nome, usuário e senha dinâmicos que serão criados nos bancos de dados
DB_NAME=protheus_prod
DB_USER=totvs
DB_PASS=TotvsPassword@123

# --- PARAMETRIZAÇÃO POSTGRESQL ------------------------------------------------
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=root_postgres_secure_password

# --- PARAMETRIZAÇÃO MS SQL SERVER --------------------------------------------
# Atenção: O SQL Server exige uma senha forte (letras, números e símbolos)
MSSQL_SA_PASSWORD=YourStrong@Password2026